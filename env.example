# Copy to .env for a local run. On Vercel these go into
# Settings, Environment Variables instead, and .env is not used.
#
# Required
RH_GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
RH_SESSION_SECRET=paste-a-long-random-string-here

# Only when the TOKEN variable in Code.gs is filled in
RH_GAS_TOKEN=

# Local server, ignored by Vercel
PORT=3000
HOST=0.0.0.0

# Set when the dashboard is served under a sub-path rather than a domain root.
# Use the same value for the build and for the server.
RH_BASE_PATH=

# Behaviour, all optional, defaults shown
RH_REQUIRE_LOGIN=yes
RH_SESSION_HOURS=12
RH_MAX_FAILED_LOGINS=5
RH_LOCKOUT_MINUTES=30
RH_CACHE_SECONDS=8
RH_TIMEOUT_SECONDS=45
RH_UPLOAD_TIMEOUT_SECONDS=120
# auto, true, or false. Use false only for a local http test.
RH_COOKIE_SECURE=auto
